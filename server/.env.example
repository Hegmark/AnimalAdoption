# Copy this file to `.env` and adjust as needed:  cp .env.example .env
# `.env` is git-ignored and must never contain real secrets.

# MongoDB connection string.
# For the local containerized MongoDB from docker-compose.yml (server running on host):
MONGODB_URI=mongodb://localhost:27017/animal_adoption

# SMTP for email notifications. In Docker these are set to the mailhog service;
# for a server running on the host, point at the published MailHog SMTP port.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Örökbefogadás <no-reply@orokbefogadas.local>
