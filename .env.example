# Root environment file read by docker compose for variable substitution.
# Copy to `.env` (git-ignored) and set a strong secret for non-dev use:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# In dev, docker-compose.yml falls back to an insecure default if this is unset.
# In prod (docker-compose.prod.yml), SESSION_SECRET is required and the stack
# refuses to start without it.
SESSION_SECRET=change-me
